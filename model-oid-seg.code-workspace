  "settings": {
    "cSpell.words": [
      "boto3",
      "botocore",
      "chunksize",
      "clearml",
      "CUDA",
      "extractall",
      "extralarge",
      "imgsz",
      "imread",
      "libbz",
      "lzma",
      "ONNX",
      "pathlib",
